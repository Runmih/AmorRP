# Use create-env.py to generate the database password and vault key privately.
# Load its output into Portainer, then fill in the two XIVAuth values locally.
# Keep every value when updating the stack. Never commit or share the filled file.
AMORRP_SERVER_IMAGE=amorrp-server:0.3.0.0
AMORRP_PUBLIC_ORIGIN=https://api.example.invalid
AMORRP_PROXY_IP=
AMORRP_DB_PASSWORD=
AMORRP_VAULT_KEY=
XIVAUTH_CLIENT_ID=
XIVAUTH_CLIENT_SECRET=
